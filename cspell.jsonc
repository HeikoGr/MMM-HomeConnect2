{
  "version": "0.2",
  // Docs and inline notes are partly German, code and identifiers are English.
  "language": "en,de-DE",
  "import": ["@cspell/dict-de-de/cspell-ext.json"],
  // Skips gitignored paths (config/config.js, config/custom.css, config/.env, cache/, ...).
  "useGitignore": true,
  "ignorePaths": [
    "node_modules/**",
    "lib/mmm-shared/**",
    "package-lock.json",
    ".git/**",
    "**/*.png",
    // Translated UI strings in languages other than en/de-DE; not covered by the "language"
    // setting above, so every non-en/de word here would otherwise be a false positive.
    "translations/da.json"
  ],
  "dictionaryDefinitions": [
    {
      "name": "project-words",
      "path": "./project-words.txt",
      "addWords": true
    }
  ],
  "dictionaries": ["project-words"]
}
