{
  "name": "mmm-homeconnect2",
  "version": "1.1.0",
  "description": "MagicMirror² Module for Home Connect",
  "main": "MMM-HomeConnect2.js",
  "author": "HeikoGr",
  "type": "commonjs",
  "engines": {
    "node": ">=20.18.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HeikoGr/MMM-HomeConnect2.git"
  },
  "keywords": [
    "MagicMirror²",
    "HomeConnect",
    "Smart Home",
    "Appliances",
    "BSH",
    "Bosch",
    "Siemens",
    "Neff",
    "Gaggenau"
  ],
  "license": "MIT",
  "scripts": {
    "prepare": "node scripts/install-hooks.js",
    "postinstall": "node scripts/install-mmm-shared-submodule.js",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "node tests/run-all.js",
    "check": "node --run mmcheck",
    "mmcheck": "node scripts/magicmirror-check.mjs --devcontainer-only --current",
    "deps:update": "npx --yes npm-check-updates -u && npm install && npx @biomejs/biome migrate --write",
    "shared:update": "git submodule update --remote --init --checkout lib/mmm-shared && git submodule status lib/mmm-shared"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,jsx,ts,tsx,json,jsonc,css}": [
      "biome check --write --files-ignore-unknown=true"
    ]
  },
  "dependencies": {
    "eventsource": "^5.1.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "lint-staged": "^17.3.0",
    "simple-git-hooks": "^2.13.1"
  },
  "simple-git-hooks": {
    "pre-commit": "npx --no-install lint-staged",
    "commit-msg": "npx --no-install commitlint --edit $1 && node scripts/check-commit-scope.js $1"
  },
  "allowScripts": {
    "simple-git-hooks@2.13.1": true
  },
  "bugs": {
    "url": "https://github.com/HeikoGr/MMM-HomeConnect2/issues"
  },
  "homepage": "https://github.com/HeikoGr/MMM-HomeConnect2"
}