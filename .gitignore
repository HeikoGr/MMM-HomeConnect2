# Logs
logs/
*.log
npm-debug.log*

# Dependencies
node_modules/

# Local MagicMirror overrides (generate these from the *.template files in config/).
# The config lives in a dot file: MagicMirror serves the module folder over HTTP, but not dot paths.
config/.env
config/.config.js
config/config.js
config/custom.css

# MagicMirror module checker (node --run check)
.mm-module-checker/
magicmirror-check-results.md

# Playwright MCP default output dir (the devcontainer config writes to /tmp instead)
.playwright-mcp/

# Home Connect OAuth token store, the persisted API rate-limit block, program start times and statistics
# (lib/module-paths.js). Up to 1.7.8 they lay in the module folder; init() moves them into .state/.
.state/
refresh_token.json
rate_limit.json
run_state.json
program_stats.json

# Local runtime cache
cache/
