# Logs
logs/
*.log
npm-debug.log*

# Dependencies
node_modules/

# Local MagicMirror overrides (generate these from the *.template files in config/)
config/.env
config/config.js
config/custom.css

# MagicMirror module checker (node --run check)
.mm-module-checker/
magicmirror-check-results.md

# Playwright MCP default output dir (the devcontainer config writes to /tmp instead)
.playwright-mcp/

# Home Connect OAuth token store, the persisted API rate-limit block, program start times and statistics
refresh_token.json
rate_limit.json
run_state.json
program_stats.json

# Local runtime cache
cache/
